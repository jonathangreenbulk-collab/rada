<?xml version="1.0" encoding="utf-8"?>
<!-- Un buque: franja de color (viene / atracado / en rada / zarpó) · nombre · resumen -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fila"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="3dp"
    android:paddingBottom="3dp"
    android:background="@drawable/toque">

    <ImageView
        android:id="@+id/franja"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="7dp"
        android:scaleType="fitXY"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/fila_nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/tinta"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-condensed"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/fila_resumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/tinta_2"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
